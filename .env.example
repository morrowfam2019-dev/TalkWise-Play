# TalkWise Play environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Whop integration -------------------------------------------------------
# Already configured in Vercel for the production project. Without all three,
# resolveWhopSession() returns null and the app runs standalone exactly as it
# does outside any host.
WHOP_API_KEY=
NEXT_PUBLIC_WHOP_APP_ID=
WHOP_EXPERIENCE_ID=

# --- Launch bridge / membership gate ----------------------------------------
# Signs launch credentials and browser session cookies. Must be at least 32
# characters of high-entropy random text, e.g.:
#
#   openssl rand -base64 48
#
# THIS IS THE MASTER SWITCH. While it is unset, membership enforcement is OFF
# and TalkWise Play is openly reachable (the behaviour it shipped with). The
# moment it is set, the gate activates: /launch, /api/launch and the protected
# route group all come alive together. Rotating it invalidates every existing
# session and every in-flight launch link, which is the intended panic button.
TALKWISE_LAUNCH_SECRET=

# Absolute origin used to build the external-browser launch URL. Optional —
# when unset it is derived from the incoming request, which is usually what you
# want so preview deployments launch into themselves rather than production.
# NEXT_PUBLIC_APP_URL=https://talkwise-play.vercel.app

# --- Durable storage (Vercel KV / Upstash Redis REST) -----------------------
# Optional but strongly recommended in production. Enables two things:
#
#   1. Absolute single-use launch credentials. Without KV, a credential is
#      still signed and expires in 2 minutes, and a replay on the instance
#      that minted it is refused — but a replay landing on a *different*
#      serverless instance inside that 2-minute window cannot be detected.
#   2. Server-backed progress, so a child's coins and unlocks follow them
#      between devices instead of living only in one browser.
#
# Without these, both features degrade safely: launches still work, and
# progress still saves to local storage exactly as it does today.
KV_REST_API_URL=
KV_REST_API_TOKEN=
